{
  "name": "stockpot",
  "version": "0.0.0",
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.4.2"
  },
  "scripts": {
    "build": "npm run build -ws",
